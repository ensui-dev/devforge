# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env
#   openssl rand -base64 48        # paste as DEVFORGE_JWT_SECRET
#
# Docker Compose reads .env automatically and passes these to the backend
# container. Running the backend directly with ./mvnw does NOT read this file —
# see "Local development" below.
#
# Every setting has a working development default in
# backend/src/main/resources/application.properties, so an empty .env still runs.
# Only DEVFORGE_JWT_SECRET genuinely must be changed before anyone else can reach
# the app.
#
# This file holds infrastructure only. The instance's name, mark, accent colour,
# registration policy, and whether documentation may be published are chosen in
# the first-run setup screen and stored in the database — so they survive a
# redeploy and can be changed without touching the environment.

# Signs and verifies access tokens. Minimum 32 characters — the application
# refuses to start below that, because a shorter key weakens HMAC-SHA256.
#
# The committed default is a known public string: anyone who has read this repo
# could mint valid tokens for a deployment still using it. Generate your own.
#
# Changing this invalidates every issued token, so all users must sign in again.
DEVFORGE_JWT_SECRET=

# Host port for the Compose database. Change it if something already owns 5432;
# then point the backend at the same port with DEVFORGE_DB_URL.
DEVFORGE_DB_PORT=5432

# Database connection. The defaults match the Compose service, so these are only
# needed for an external database or a non-default port.
# DEVFORGE_DB_URL=jdbc:postgresql://localhost:5432/devforge
# DEVFORGE_DB_USERNAME=devforge
# DEVFORGE_DB_PASSWORD=devforge

# Comma-separated origins allowed to call the API from a browser. Leave empty
# when the client is served from the same origin (the Vite dev server proxies
# /api, and so does nginx in the full Compose stack) — CORS then stays off.
# Set it only if you host the frontend on a different domain.
# DEVFORGE_CORS_ORIGINS=https://devforge.example.com

# Port the backend listens on.
# PORT=8080
